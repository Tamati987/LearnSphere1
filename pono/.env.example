PORT=3000

# --- Assistant IA (laisser vide = mode démo gratuit) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Nombre maximum de réponses IA par jour (au-delà : réponses de démo, aucun coût)
AI_DAILY_LIMIT=300

# --- Espace admin (/admin) : 24 caractères minimum ---
# Générer : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# --- Stockage ---
# Sur Railway, ajoutez un volume : il est détecté automatiquement.
# Sinon, indiquez un dossier persistant :
# DATA_DIR=/data
RETENTION_DAYS=365

# --- Adresse publique du site (pour les aperçus Facebook / WhatsApp) ---
SITE_URL=https://votre-domaine.pf

# --- Coordonnées affichées sur le site et les pages légales ---
BUSINESS_NAME=PONO
# Laisser vide si vous n'avez pas d'adresse : les visiteurs utiliseront le formulaire
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_LOCATION=Polynésie française
BUSINESS_OWNER=
BUSINESS_LEGAL_ID=
BUSINESS_ADDRESS=
