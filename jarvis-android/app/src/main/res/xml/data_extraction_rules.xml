<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde dans le cloud et transfert vers un nouveau téléphone (Android 12 et plus) :
     la base de Jarvis (historique, mémoire, réveils, routines) et ses réglages.
     Les secrets chiffrés sont exclus : leur clé reste dans le téléphone d'origine. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="jarvis.db" />
        <include domain="sharedpref" path="jarvis.xml" />
        <include domain="sharedpref" path="jarvis_alarm.xml" />
        <include domain="sharedpref" path="jarvis_weather.xml" />
        <exclude domain="sharedpref" path="jarvis_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="jarvis.db" />
        <include domain="sharedpref" path="jarvis.xml" />
        <include domain="sharedpref" path="jarvis_alarm.xml" />
        <include domain="sharedpref" path="jarvis_weather.xml" />
        <exclude domain="sharedpref" path="jarvis_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
