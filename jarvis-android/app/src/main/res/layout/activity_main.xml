<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- Réglages : les clés d'accès -->
    <ScrollView
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/Title"
                android:text="JARVIS" />

            <TextView
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:text="@string/setup_intro" />

            <TextView
                style="@style/Label"
                android:text="Clé API Anthropic (obligatoire)" />

            <EditText
                android:id="@+id/anthropic_key"
                style="@style/Field"
                android:hint="sk-ant-…"
                android:inputType="textPassword" />

            <TextView
                style="@style/Label"
                android:text="Clé ElevenLabs (facultatif, voix réaliste)" />

            <EditText
                android:id="@+id/elevenlabs_key"
                style="@style/Field"
                android:hint="Clé API ElevenLabs"
                android:inputType="textPassword" />

            <CheckBox
                android:id="@+id/announce_sms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:buttonTint="@color/core"
                android:text="Annoncer à voix haute les appels et les nouveaux messages (SMS, WhatsApp, Messenger)"
                android:textColor="@color/fg"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/read_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/core"
                android:text="Lire aussi le texte des messages dans l'annonce (sinon, seulement l'expéditeur)"
                android:textColor="@color/fg"
                android:textSize="16sp" />

            <TextView
                style="@style/Label"
                android:text="Jeton GitHub (facultatif, gardé chiffré)" />

            <EditText
                android:id="@+id/github_token"
                style="@style/Field"
                android:hint="github_pat_…"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/github_repo"
                style="@style/Field"
                android:hint="Dépôt : propriétaire/nom"
                android:inputType="text" />

            <TextView
                style="@style/Label"
                android:text="Sensibilité de « Hey Jarvis »" />

            <RadioGroup
                android:id="@+id/sensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/sensitivity_normal"
                    style="@style/Choice"
                    android:text="Normale : se déclenche rarement par erreur" />

                <RadioButton
                    android:id="@+id/sensitivity_high"
                    style="@style/Choice"
                    android:text="Élevée (conseillée) : entend mieux l'accent français" />

                <RadioButton
                    android:id="@+id/sensitivity_max"
                    style="@style/Choice"
                    android:text="Très élevée : si Jarvis ne vous entend toujours pas" />
            </RadioGroup>

            <Button
                android:id="@+id/save"
                style="@style/Primary"
                android:layout_marginTop="24dp"
                android:text="Enregistrer et démarrer" />

            <TextView
                style="@style/Label"
                android:text="Mode hors ligne (modèle de langage sur le téléphone)" />

            <TextView
                android:id="@+id/offline_status"
                style="@style/Body"
                android:layout_marginTop="4dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/offline_url"
                style="@style/Field"
                android:hint="Lien direct du modèle .task (Gemma)"
                android:inputType="textUri" />

            <Button
                android:id="@+id/offline_download"
                style="@style/Secondary"
                android:layout_marginTop="8dp"
                android:text="Télécharger en Wi-Fi" />

            <Button
                android:id="@+id/offline_import"
                style="@style/Secondary"
                android:layout_marginTop="8dp"
                android:text="Installer un modèle déjà téléchargé" />

            <TextView
                style="@style/Label"
                android:text="Mes données" />

            <Button
                android:id="@+id/export_data"
                style="@style/Secondary"
                android:layout_marginTop="8dp"
                android:text="Exporter dans Téléchargements" />

            <Button
                android:id="@+id/import_data"
                style="@style/Secondary"
                android:layout_marginTop="8dp"
                android:text="Réimporter une sauvegarde" />

            <Button
                android:id="@+id/clear_history"
                style="@style/Secondary"
                android:layout_marginTop="8dp"
                android:text="Effacer l'historique des conversations" />

            <Button
                android:id="@+id/wallpaper"
                style="@style/Secondary"
                android:layout_marginTop="12dp"
                android:text="Mettre Jarvis en fond d'écran" />
        </LinearLayout>
    </ScrollView>

    <!-- Console : état, journal de conversation, commandes -->
    <LinearLayout
        android:id="@+id/console"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Title"
            android:text="JARVIS" />

        <TextView
            android:id="@+id/status"
            style="@style/Label"
            android:layout_marginTop="4dp"
            android:text="Hors ligne" />

        <Button
            android:id="@+id/overlay"
            style="@style/Secondary"
            android:layout_marginTop="12dp"
            android:text="Autoriser Jarvis à ouvrir des applis"
            android:visibility="gone" />

        <Button
            android:id="@+id/notifications"
            style="@style/Secondary"
            android:layout_marginTop="8dp"
            android:text="Autoriser la lecture de WhatsApp et Messenger"
            android:visibility="gone" />

        <Button
            android:id="@+id/battery"
            style="@style/Secondary"
            android:layout_marginTop="8dp"
            android:text="Autoriser l'écoute écran verrouillé"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/log"
                style="@style/Body"
                android:textIsSelectable="true" />
        </ScrollView>

        <EditText
            android:id="@+id/input"
            style="@style/Field"
            android:hint="Écrire à Jarvis…"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/talk"
                style="@style/Primary"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:text="Parler" />

            <Button
                android:id="@+id/toggle"
                style="@style/Secondary"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Activer" />

            <Button
                android:id="@+id/settings"
                style="@style/Secondary"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Clés" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
