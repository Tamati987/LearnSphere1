# ─── Printful ─────────────────────────────────────────────────────────
# Printful > Settings > Developers > API tokens (token du store DAYTHO 987)
PRINTFUL_API_KEY=
# Seulement si ton token gère plusieurs stores : ID du store DAYTHO 987
PRINTFUL_STORE_ID=
# false = la commande arrive en BROUILLON dans Printful (tu valides à la main)
# true  = envoyée directement en production (Printful débite ta carte)
PRINTFUL_AUTO_CONFIRM=false

# ─── Stripe ───────────────────────────────────────────────────────────
# Stripe > Développeurs > Clés API (sk_test_... pour tester, sk_live_... en prod)
STRIPE_SECRET_KEY=
# Stripe > Développeurs > Webhooks > endpoint https://TON-SITE/api/webhooks/stripe
# événements : checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# ─── Site ─────────────────────────────────────────────────────────────
# URL publique (ex : https://daytho987.up.railway.app)
SITE_URL=
# Frais de livraison facturés au client, en centimes (0 = offerte)
SHIPPING_FLAT_CENTS=0
# Mot de passe pour /api/admin/printful-products (choisis une longue chaîne aléatoire)
ADMIN_TOKEN=
