# --- PayPal (https://developer.paypal.com/dashboard/applications) ---
PAYPAL_ENV=sandbox            # "sandbox" pour tester, "live" pour encaisser réellement
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Identité légale du vendeur (obligatoire pour ouvrir les ventes) ---
SELLER_NAME=                  # ex : Prénom Nom
SELLER_STATUS=                # ex : Entrepreneur individuel (micro-entreprise)
SELLER_SIRET=
SELLER_ADDRESS=
SELLER_EMAIL=
SELLER_MEDIATOR=              # nom + site du médiateur de la consommation choisi
SELLER_VAT_MENTION=TVA non applicable, art. 293 B du CGI

# --- Produit ---
PRODUCT_PRICE=27.00

# --- Technique ---
DATABASE_URL=                 # fourni automatiquement par Railway Postgres
SITE_URL=                     # ex : https://learnsphere.up.railway.app
NODE_ENV=production
